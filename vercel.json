{
  "regions": ["icn1"],
  "functions": {
    "api/**/*.py": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/team/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/match/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
